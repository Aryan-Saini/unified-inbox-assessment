{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "t3-logo.png",
  "scripts": [
    {
      "name": "Copy .env.local",
      "command": "./scripts/link-env-local.sh",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "Dev",
      "command": "pnpm dev",
      "icon": "play",
      "previewUrl": "http://localhost:3000",
      "autoOpenPreview": true
    },
    {
      "name": "Convex Dev",
      "command": "pnpm exec convex ai-files install; pnpm dev:convex",
      "icon": "configure"
    },
    {
      "name": "Typecheck",
      "command": "pnpm typecheck",
      "icon": "test"
    },
    {
      "name": "Lint",
      "command": "pnpm lint",
      "icon": "lint"
    },
    {
      "name": "Build",
      "command": "pnpm build",
      "icon": "build"
    }
  ]
}
