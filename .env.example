# Clerk — from the Clerk dashboard (API keys page)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk Frontend API / JWT issuer URL, e.g. https://verb-noun-00.clerk.accounts.dev
# Also set on the Convex deployment:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN <value>
CLERK_JWT_ISSUER_DOMAIN=https://verb-noun-00.clerk.accounts.dev

# Clerk webhook signing secret — from the webhook endpoint's page in the Clerk
# dashboard. Belongs to the Convex deployment, not to Next.js, and each endpoint
# has its own, so the dev and staging deployments get different values:
#   npx convex env set        CLERK_WEBHOOK_SIGNING_SECRET whsec_...
#   npx convex env set --prod CLERK_WEBHOOK_SIGNING_SECRET whsec_...
# Listed here for documentation only — do not put it in .env.local.

# --- Convex deployment env vars (not Next.js) --------------------------------
# Everything in this block belongs to the Convex deployment, set with
# `npx convex env set <NAME> <value>` (add --prod for production). Listed here as
# documentation only — do not put them in .env.local.
#
#   TOKEN_ENCRYPTION_KEY          openssl rand -base64 32. Per-deployment: the
#                                 key that decrypts one deployment's tokens must
#                                 not decrypt another's.
#   GOOGLE_OAUTH_CLIENT_ID        GCP console -> Credentials -> OAuth client
#   GOOGLE_OAUTH_CLIENT_SECRET      (Web application). Authorised redirect URI:
#                                   https://<slug>.convex.site/oauth/google/callback
#   SLACK_CLIENT_ID               Slack app -> Basic Information. Redirect URL:
#   SLACK_CLIENT_SECRET             https://<slug>.convex.site/oauth/slack/callback
#   APP_BASE_URL                  Fallback origin the OAuth callback returns the
#                                 browser to, e.g. http://localhost:3000. The
#                                 browser proposes its own origin and that wins
#                                 when it is loopback (any port) or registered
#                                 below; anything else lands here. Resolving
#                                 returnTo against an origin we chose is what
#                                 stops it being an open redirect.
#   APP_ORIGIN_ALLOWLIST          Optional, comma-separated. Extra origins the
#                                 callback may return to, for a deployed frontend
#                                 that is not APP_BASE_URL. Localhost never needs
#                                 listing — it is allowed on any port.
#   ALLOW_PRIVATE_NETWORK_ORIGINS "true" also allows a private-network origin
#                                 (10.x, 172.16-31.x, 192.168.x, link-local,
#                                 *.local) on any port, so a phone on the same
#                                 Wi-Fi can finish an OAuth flow. `pnpm dev:lan`
#                                 sets this on dev. Leave unset on deployed.
#   WEB_SEARCH_PROVIDER           tavily | brave | mock (default mock)
#   WEB_SEARCH_API_KEY            key for the chosen provider
#   ALLOW_FAULT_INJECTION         "true" to enable the demo failure switches
#
# CONVEX_SITE_URL is injected by Convex itself and is what the OAuth redirect URI
# is derived from, so it cannot drift between deployments.

# --- .env.deploy (a different file, for `pnpm deploy`) -----------------------
# Names only, no values — the real file is `.env.deploy` at the repo root and it
# is git-ignored. Everything the deploy pipeline needs lives there:
#
#   CONVEX_DEPLOY_KEY   Convex dashboard -> deployed environment -> Settings ->
#                       Deploy Keys -> Generate Production Deploy Key. With it,
#                       `pnpm deploy:vercel` uses `convex deploy --cmd`, so the
#                       backend ships and the frontend is built against it in one
#                       step. Not stored on Vercel: the build runs locally, and a
#                       sensitive Vercel variable pulls back empty.
#   SMOKE_BASE_URL      Optional. The deployed Convex HTTP API to verify.
#                       Defaults to the deployed environment.
#   SMOKE_API_KEY       A uik_… key for the account the verification exercises.
#                       Created in the app under Settings -> API keys.
#   SMOKE_RECIPIENT     Where the double-tap sends its one real message.
#   SMOKE_APP_URL       Optional. The deployed Vercel URL; enables the docs check.
#   SMOKE_N             Optional. Parallel sends in the double-tap (default 10).

# Convex — the checked-in frontend defaults point at the shared dev deployment.
# `pnpm exec convex dev` adds CONVEX_DEPLOYMENT when backend development is needed.
# Supply CONVEX_DEPLOY_KEY as a Codespaces secret for non-interactive backend
# development. Never paste a deploy key into this file.
# CONVEX_DEPLOYMENT=dev:...
NEXT_PUBLIC_CONVEX_URL=https://judicious-wildcat-326.convex.cloud
# Base URL for Convex HTTP actions (the webhook lives here)
NEXT_PUBLIC_CONVEX_SITE_URL=https://judicious-wildcat-326.convex.site
